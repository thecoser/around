# Explicit local demo modes. Never silently fall back from providers.
RING_MODE=fixture
AI_MODE=fixture
AROUND_TIME_ZONE=America/New_York
AROUND_DB_PATH=data/around-fixture.sqlite
# To connect Ring, set RING_MODE=ring and use a separate database.
# Optional: leave blank and paste a temporary token into the local sync form.
RING_ACCESS_TOKEN=
RING_ACCOUNT_ID=
RING_HMAC_KEY=
# Set playground for the official single-device Playground; configured for two devices.
RING_DEVICE_MODE=configured
# Ring directed device IDs, used to give physical meaning to events.
RING_DRIVEWAY_DEVICE_ID=
RING_FRONT_DOOR_DEVICE_ID=
# AI_MODE=bedrock requires region, model ID and a temporary UI key or AWS SDK identity.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
# Optional SDK profile, set locally. Never commit credentials.
# AWS_PROFILE=around
